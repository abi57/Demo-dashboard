DATABASE_URL=postgresql://postgres:zmtMWzAkWlERWlbVccFUEEIJxJBgFwtb@postgres.railway.internal:5432/railway
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRE_MINUTES=1440

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
S3_BUCKET=viotel-media
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT_URL=
# Leave S3_ENDPOINT_URL empty for AWS S3, or set for R2/MinIO e.g. https://xxx.r2.cloudflarestorage.com

# For local dev without S3, files save to server/uploads/
USE_LOCAL_STORAGE=true
