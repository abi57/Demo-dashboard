# Database
DATABASE_URL=postgresql://user:password@localhost:5432/viotel

# Authentication
JWT_SECRET=generate-a-strong-random-secret-min-32-chars
JWT_EXPIRE_MINUTES=1440

# S3-compatible storage (Railway Object Storage or AWS S3)
S3_ENDPOINT=https://your-bucket-endpoint.example.com
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_REGION=us-east-1

# Alternative Railway variable names (also supported):
# BUCKET_ENDPOINT=
# BUCKET_NAME=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_REGION=

# Set to true for local development (saves files to server/uploads/)
USE_LOCAL_STORAGE=true

# CORS allowed origins (comma-separated, use * for development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
