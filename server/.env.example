DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/viotel
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRE_MINUTES=1440

# Railway S3-compatible storage
AWS_ENDPOINT_URL=https://your-bucket.s3.railway.app
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_DEFAULT_REGION=us-east-1

# Set to true for local dev (saves files to server/uploads/)
USE_LOCAL_STORAGE=true
